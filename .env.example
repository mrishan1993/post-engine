# Database — SQLite by default; swap to Postgres later via DATABASE_URL only
DATABASE_URL=sqlite:///./storage/pipeline.db

# Runtime
STORAGE_ROOT=./storage
PIPELINE_STUB_PROVIDERS=true
TREND_STUB_COLLECTORS=true
AMP_CREDENTIALS_KEY=amp-dev-credentials-key-change-me

# LLM
ANTHROPIC_API_KEY=

# TTS / Music
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
SUNO_API_KEY=

# Image gen (pick at least one)
FAL_KEY=
REPLICATE_API_TOKEN=
OPENAI_API_KEY=
MIDJOURNEY_API_KEY=
GOOGLE_API_KEY=

# Video gen (pick at least one)
RUNWAY_API_KEY=

# YouTube Data API (API key for public trend charts; OAuth for publishing)
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Temporary public hosting for Instagram (signed URL source)
TEMP_HOSTING_BASE_URL=

# Alerts
ALERT_WEBHOOK_URL=
