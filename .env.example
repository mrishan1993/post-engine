# Database — SQLite by default; swap to Postgres later via DATABASE_URL only
DATABASE_URL=sqlite:///./storage/pipeline.db

# LLM
ANTHROPIC_API_KEY=

# TTS / Music
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
SUNO_API_KEY=

# Image gen (optional until generative verticals)
MIDJOURNEY_API_KEY=

# YouTube OAuth (refresh-token flow)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Temporary public hosting for Instagram (signed URL source)
TEMP_HOSTING_BASE_URL=

# Alerts
ALERT_WEBHOOK_URL=

# Runtime
PIPELINE_STUB_PROVIDERS=true
STORAGE_ROOT=./storage
